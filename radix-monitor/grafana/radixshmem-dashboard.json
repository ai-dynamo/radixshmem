          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (tree, rank, role) (radixshmem_pool_slots_used{cluster=\"$cluster\",pool=\"full\"} / radixshmem_pool_slots_total{cluster=\"$cluster\",pool=\"full\"})",
          "refId": "C",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (tree, rank, role) (radixshmem_pool_slots_used{cluster=\"$cluster\",pool=\"swa\"} / radixshmem_pool_slots_total{cluster=\"$cluster\",pool=\"swa\"})",
          "refId": "G",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (tree, rank, role) (radixshmem_pool_slots_used{cluster=\"$cluster\",pool=\"mamba\"} / radixshmem_pool_slots_total{cluster=\"$cluster\",pool=\"mamba\"})",
