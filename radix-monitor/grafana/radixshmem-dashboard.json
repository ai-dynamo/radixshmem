{
  "uid": "radixshmem-cluster",
  "title": "radixshmem cluster",
  "tags": [
    "radixshmem"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(radixshmem_ready, cluster)",
          "refId": "cluster"
        },
        "definition": "label_values(radixshmem_ready, cluster)",
        "refresh": 1,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "tree",
        "label": "Node tree (largest first)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "query_result(sort_desc(radixshmem_tree_blocks{cluster=\"$cluster\"}))",
          "refId": "tree"
        },
        "definition": "query_result(sort_desc(radixshmem_tree_blocks{cluster=\"$cluster\"}))",
        "regex": "/tree=\"([^\"]+)\"/",
        "refresh": 1,
        "sort": 0,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Servers ready",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(radixshmem_ready{cluster=\"$cluster\"})",
          "refId": "A",
          "legendFormat": "ready",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(radixshmem_ready{cluster=\"$cluster\"})",
          "refId": "B",
          "legendFormat": "total",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Blocks cached",
      "description": "Blocks in every server's radix tree, added up before dedup: a block cached on N servers counts N times",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(radixshmem_tree_blocks{cluster=\"$cluster\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Duplication",
      "description": "Blocks cached / distinct prefix blocks (each prefix counted once over the cluster)",
