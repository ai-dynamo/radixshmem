        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (tree, rank, role) (rate(radixshmem_inserts_total{cluster=\"$cluster\"}[1m]))",
          "refId": "E",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
