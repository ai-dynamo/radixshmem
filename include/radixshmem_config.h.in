#pragma once

// Built without RDMA (libibverbs): every distributed feature compiles out.
#cmakedefine RADIXSHMEM_NO_RDMA 1

// RDMA present: the DC (DCI/DCT) remote-op control-plane backend compiles in.
#cmakedefine RADIXSHMEM_REMOTE_OP_RDMA 1

// libzmq present: the ZMQ remote-op backend (fallback transport) compiles in.
#cmakedefine RADIXSHMEM_HAS_ZMQ 1

// grpc++ / protobuf present: the gRPC remote-op backend compiles in.
#cmakedefine RADIXSHMEM_HAS_GRPC 1

// etcd present (Go client wrapper libradix_etcd.so): the etcd-based cluster
// bootstrap registry compiles in. The sole cluster bootstrap path in RDMA builds.
#cmakedefine RADIXSHMEM_HAS_ETCD 1

// Mooncake TransferEngine present: the data plane's Mooncake transfer backend
// (src/transfer/mooncake) compiles in. Data plane only — no indexer impact.
#cmakedefine RADIXSHMEM_HAS_MOONCAKE 1

// NIXL (backend="UCX") present: the data plane's NIXL transfer backend
// (src/transfer/nixl) compiles in. Data plane only — no indexer impact.
#cmakedefine RADIXSHMEM_HAS_NIXL 1
